<h1>DANH SACH SU KIEN</h1>
<form action="/search" method="get" style="margin-bottom: 20px;">
    <input type="text" name="keyword" id="">
    <select name="status" id="">
        <option value="">-- tat ca trang thai --</option>
        <option value="Upcoming">Upcoming</option>
        <option value="Sold">Sold</option>
        <option value="Cancelled">Cancelled</option>
    </select>
    <button type="submit"> tim va loc</button>
</form>
<a href="/add">+Them ve moi</a>
<br> <br>
<div style="display: flex;flex-wrap: wrap;gap: 20px; ">
    <% tickets.forEach(t=>{
        const qty= Number(t.quantity)
        const price= Number(t.pricePerTicket)
        const total=qty*price

        let discount=0
        if(t.category ==="VIP"&&qty>=4) discount=0.1;
        else if(t.category ==="VVIP"&&qty>=2) discount=0.15;
        const final=total*(1-discount);
        %>
            <div style="border:1px solid black;padding: 10px;width: 250px;">
                <img src="<%= t.imageUrl %>" alt="" style="width: 100%;height: 150px;object-fit: cover;background: black;">
                <h3><%= t.eventName %></h3>
                <p>Ten Nguoi To Chuc: <b><%= t.holderName %></b></p>
                <p>Gia: <%= t.pricePerTicket %> | <%= t.quantity %></p>
                <p>Trang thai: <b><%= t.status %></b></p>
                <hr>
                <p>Thanh tien: <b><%= final.toLocaleString() %></b> VND</p>

                <%
                    if(discount>0){%>
                        <p style="color: red;font-size: 12px;">(Da giam gia <%= discount*10 %> )</p>    
                    <%}
                %>
                <div style="margin-top: 10px;">
                    <a href="/delete/<%= t.ticketId %>" onclick="return confirm('Xoa ?')">Xoa</a>
                    <a href="/edit/<%= t.ticketId %>">Sua</a>
                    <a href="/detail/<%= t.ticketId %>"">Chi Tiet</a>
                </div>
            </div>
        <%
    })

    %>
</div>
<%
                    if(tickets.length===0){%>
                        <p>khong co du lieu</p>    
                    <%}
                %>